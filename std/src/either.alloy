module Either
where

import std::eq::Eq
import std::order::{Ord, Ordering}
import std::debug::Debug
import std::functor::Functor
import std::applicative::Applicative
import std::monad::Monad

--! `Either` represents either right (`Right`) or left (`Left`)
typedef Either[l, r] =
    | Left(l)
    | Right(r)
end


behavior Eq for Either[l, r] where
  typevar l = Eq
  typevar r = Eq

  let eq = |left, right| ->
    match (left, right) when
      \ (Either::Left(l_val), Either::Left(r_val))   -> Eq::eq(l_val, r_val)
      \ (Either::Right(l_val), Either::Right(r_val)) -> Eq::eq(l_val, r_val)
      \ _                            -> False
end


behavior Ord for Either[l, r] where
  typevar l = Ord
  typevar r = Ord

  let compare = |left, right| ->
    match (left, right) when
      \ (Either::Right(l_val), Either::Right(r_val)) -> Ord::compare(l_val, r_val)
      \ (Either::Left(l_val), Either::Left(r_val))   -> Ord::compare(l_val, r_val)
      \ (Either::Right(_), Either::Left(_))          -> Ordering::LT
      \ (Either::Left(_), Either::Right(_))          -> Ordering::GT
end


behavior Debug for Either[l, r] where
  typevar l = Debug
  typevar r = Debug

  let debug = |e| ->
    match e when
      \ (Either::Left(x))  -> "Either::Left(#{x})"
      \ (Either::Right(x)) -> "Either::Right(#{x})"
end


behavior Functor for Either[l, _] where
  typevar l

  typeof map : (r1 -> r2) -> Either[l, r1] -> Either[l, r2] where
    typevar r1
    typevar r2
  let map = |convert, x| -> match x when
    \ (Either::Right(x_val)) -> Either::Right(convert(x_val))
    \ (Either::Left(x_val))  -> Either::Left(x_val)
end


behavior Applicative for Either[l, _] where
  typevar l

  typeof apply : Either[l, (r1 -> r2)] -> Either[l, r1] -> Either[l, r2] where
    typevar r1
    typevar r2
  let apply = |f, x| -> match (f, x) when
    \ (Either::Right(f_val), Either::Right(x_val)) -> Either::Right(f_val(x_val))
    \ (Either::Right(_),     Either::Left(x_val))  -> Either::Left(x_val)
    \ (Either::Left(f_val),  _)            -> Either::Left(f_val)


  typeof wrap : r1 -> Either[l, r1] where
    typevar r1
  let wrap = |x| -> Either::Right(x)
end


behavior Monad for Either[l, _] where
  typevar l

  typeof flat_map : (r1 -> Either[l, r2]) -> Either[l, r1] -> Either[l, r2] where
    typevar r1
    typevar r2
  let flat_map = |convert, x| -> match x when
    \ (Either::Right(x_val)) -> convert(x_val)
    \ (Either::Left(x_val))  -> Either::Left(x_val)

end
